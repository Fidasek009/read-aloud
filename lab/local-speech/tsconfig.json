{
	"compilerOptions": {
		"target": "ES2024",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"lib": ["ES2024", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
		"types": ["bun"],
		"skipLibCheck": true
	},
	"include": ["src/page.ts", "src/wav.ts", "src/contracts.ts", "scripts/**/*.ts", "test/**/*.ts"]
}
