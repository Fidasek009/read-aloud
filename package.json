{
	"name": "read-aloud",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"packageManager": "bun@1.4.4",
	"engines": {
		"bun": ">=1.4.4"
	},
	"scripts": {
		"dev": "bun --bun run wxt --mv3",
		"dev:firefox": "bun --bun run wxt --browser firefox --mv3",
		"prepare": "bun --bun run wxt prepare",
		"typecheck": "bun run prepare && bun check && bun check -p tsconfig.speech.json && bun check -p tsconfig.tools.json",
		"test": "bun test tests",
		"format": "bun fmt",
		"format:check": "bun fmt --check",
		"build": "bun --bun run wxt build --mv3",
		"build:firefox": "bun --bun run wxt build --browser firefox --mv3",
		"zip": "bun --bun run wxt zip --mv3",
		"zip:firefox": "bun --bun run wxt zip --browser firefox --mv3",
		"probe:chrome": "bun scripts/probe-product.ts",
		"probe:host": "bun scripts/probe-host-lifecycle.ts",
		"probe:firefox": "bun scripts/probe-product-firefox.ts",
		"probe:speakers": "bun scripts/probe-speakers.ts",
		"probe:pdf": "bun scripts/probe-pdf.ts",
		"probe:previews": "bun scripts/probe-previews.ts",
		"probe:pdf:speech": "PDF_CHECK_SPEECH=1 bun scripts/probe-pdf.ts",
		"lint:workflows": "bun scripts/lint-workflows.ts",
		"check:source-rebuild": "bun scripts/check-source-rebuild.ts"
	},
	"devDependencies": {
		"@types/bun": "1.4.4",
		"@webgpu/types": "0.1.74",
		"protobufjs": "8.8.1",
		"typescript": "7.0.2",
		"wxt": "0.21.5"
	},
	"dependencies": {
		"@spelling-creator/spellophone": "0.2.1",
		"onnxruntime-web": "1.31.1",
		"pdfjs-dist": "6.5.438"
	}
}
